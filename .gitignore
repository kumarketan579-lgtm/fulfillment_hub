# ==========================================
# Fulfillment Hub - Git Ignore Configuration
# ==========================================

# Byte-compiled / optimized / cache files
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Local Database Files (Database is auto-created & seeded via sample_data.py on startup)
*.db
*.sqlite
*.sqlite3
fulfillment_hub.db

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.secret
*.pem
*.key

# Logs and runtime artifacts
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Unit test & coverage reports
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Editor & IDE specific configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# Operating System artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Packaging / Distribution
dist/
build/
*.egg-info/
*.egg
